{
  "id": "spotify",
  "name": "Spotify",
  "version": "0.1.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "open.spotify.com",
      "api-partner.spotify.com",
      "spclient.wg.spotify.com",
      "gist.githubusercontent.com",
      "music.youtube.com",
      "lrclib.net"
    ],
    "process": [
      "ffmpeg",
      "yt-dlp",
      "/opt/homebrew/bin/ffmpeg",
      "/opt/homebrew/bin/yt-dlp",
      "/usr/local/bin/ffmpeg",
      "/usr/local/bin/yt-dlp"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "builtin": "stations"
    },
    {
      "builtin": "liked"
    }
  ]
}
